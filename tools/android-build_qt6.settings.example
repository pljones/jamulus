# Copy to android-build_qt6.settings in the repository root (gitignored), or
# pass --settings /path/to/file. Values here override existing environment
# values and tools/android-build.sh defaults. Command-line options take
# precedence.

# JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
# ANDROID_SDK_ROOT=/opt/android-sdk
# ANDROID_NDK_ROOT=${ANDROID_SDK_ROOT}/ndk/27.3.13750724
# ANDROID_BUILD_TOOLS=36.0.0
# QT_DIR=/opt/Qt
# ANDROID_DEPLOYMENT_PLATFORM=android-36

# Defaults to "debug release". Set BUILD_MODES=release to skip the debug APK.
# BUILD_MODES=release
TARGET_ARCHS=arm64-v8a

# Optional qmake CONFIG values, space-separated:
# JAMULUS_ANDROID_QMAKE_CONFIG="serveronly disable_version_check"

# To build an AAB outside the `play-store` stage:
# JAMULUS_ANDROID_PACKAGE_FORMAT=aab

# Optional release signing (keep these outside the repository):
# JAMULUS_ANDROID_KEYSTORE=${HOME}/Jamulus/jamulus-upload.jks
# JAMULUS_ANDROID_KEY_ALIAS=jamulus
# JAMULUS_ANDROID_KEYSTORE_PASSWORD=production-password
# JAMULUS_ANDROID_KEY_PASSWORD=production-password
