# Copy to android-build_legacy.settings in the repository root (gitignored), or
# pass --settings /path/to/file. Values here override existing environment
# values and tools/android-build.sh defaults. Command-line options take
# precedence.

# JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64
# ANDROID_SDK_ROOT=/opt/android-sdk
# ANDROID_NDK_ROOT=${ANDROID_SDK_ROOT}/ndk/21.0.6113669
# ANDROID_BUILD_TOOLS=30.0.2
# QT_DIR=/opt/Qt
# ANDROID_DEPLOYMENT_PLATFORM=android-30

# Narrow these for faster local rebuilds:
BUILD_MODES=release
TARGET_ARCHS=arm64-v8a

# Optional qmake CONFIG values, space-separated:
# JAMULUS_ANDROID_QMAKE_CONFIG="serveronly disable_version_check"

# Override the default `_legacy` artifact suffix if necessary:
# JAMULUS_ANDROID_ARTIFACT_SUFFIX=_custom

# Optional side-load release signing (keep these outside the repository):
# JAMULUS_ANDROID_KEYSTORE=${HOME}/Jamulus/jamulus-dev.jks
# JAMULUS_ANDROID_KEY_ALIAS=jamulus
# JAMULUS_ANDROID_KEYSTORE_PASSWORD=devpassword
# JAMULUS_ANDROID_KEY_PASSWORD=devpassword
